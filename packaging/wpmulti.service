[Unit]
Description=wpmulti Multi-Tunnel WireGuard Userspace Proxy Daemon
Documentation=https://github.com/pkok1099/wpmulti-rs
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=wpmulti
Group=wpmulti
ExecStart=/usr/bin/wpmulti run -c /etc/wpmulti/wpmulti.toml
Restart=on-failure
RestartSec=3
LimitNOFILE=65536

# Security hardening
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadOnlyPaths=/etc/wpmulti
ReadWritePaths=/etc/wpmulti/wpmulti.toml
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
AmbientCapabilities=CAP_NET_BIND_SERVICE

[Install]
WantedBy=multi-user.target
